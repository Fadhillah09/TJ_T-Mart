                },
                "responses": {
                    "201": {
                        "description": "Order created"
                    },
                    "422": {
                        "description": "Stock insufficient"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/riwayat-pembelian/{id}": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "Order detail",
                "operationId": "ordersShow",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
