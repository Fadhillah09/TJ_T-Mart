                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "tepat_waktu",
                                "terlambat",
                                "mangkir"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Attendance list"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "ApiSuccessResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "OK"
                    },
                    "data": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "ApiErrorResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "Validasi gagal."
                    },
                    "errors": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "LoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "customer@tjmart.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password"
                    }
                },
                "type": "object"
            },
            "RegisterRequest": {
                "required": [
                    "name",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "Password1a"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password",
                        "example": "Password1a"
                    },
                    "phone": {
                        "type": "string",
                        "example": "081234567890"
                    },
                    "nomor_kamar": {
                        "type": "string",
                        "example": "A-101"
                    },
                    "penghuni_asrama": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "CartItemRequest": {
                "required": [
                    "produk_id",
                    "quantity"
                ],
                "properties": {
                    "produk_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "quantity": {
                        "type": "integer",
                        "example": 2,
                        "minimum": 1
                    }
                },
                "type": "object"
            },
            "CheckoutRequest": {
                "required": [
                    "tipe_layanan",
                    "metode_pembayaran",
                    "items"
                ],
                "properties": {
                    "tipe_layanan": {
                        "type": "string",
                        "example": "delivery",
                        "enum": [
                            "pickup",
                            "delivery"
                        ]
                    },
                    "metode_pembayaran": {
                        "type": "string",
                        "example": "COD",
                        "enum": [
                            "COD",
                            "MIDTRANS"
                        ]
                    },
                    "alamat_pengantaran": {
                        "type": "string",
                        "example": "Asrama TJ Blok A Kamar 101"
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "required": [
                                "produk_id",
                                "quantity"
                            ],
                            "properties": {
                                "produk_id": {
                                    "type": "integer",
                                    "example": 1
                                },
                                "quantity": {
                                    "type": "integer",
                                    "example": 2
                                }
                            },
                            "type": "object"
                        }
                    }
                },
                "type": "object"
            },
            "GalonRequest": {
                "required": [
                    "nama_galon",
                    "jumlah",
                    "metode_pembayaran",
                    "metode_pengiriman"
                ],
                "properties": {
                    "nama_galon": {
                        "type": "string",
                        "example": "Galon 19L (Isi Ulang)",
                        "enum": [
                            "Galon Baru + Isi",
                            "Galon 19L (Isi Ulang)"
                        ]
                    },
                    "jumlah": {
                        "type": "integer",
                        "example": 2,
                        "maximum": 50,
                        "minimum": 1
                    },
                    "metode_pembayaran": {
                        "type": "string",
                        "example": "COD",
                        "enum": [
                            "COD",
                            "MIDTRANS"
                        ]
                    },
                    "metode_pengiriman": {
                        "type": "string",
                        "example": "antar",
                        "enum": [
                            "ambil",
                            "antar"
                        ]
                    },
                    "catatan": {
                        "type": "string",
                        "example": "Antar ke kamar A-101"
                    }
                },
                "type": "object"
            },
            "TokenRequest": {
                "required": [
                    "nominal",
                    "metode_pembayaran"
                ],
                "properties": {
                    "nominal": {
                        "type": "integer",
                        "example": 50000,
                        "enum": [
                            20000,
                            50000,
                            100000,
                            200000,
                            500000
                        ]
                    },
                    "metode_pembayaran": {
                        "type": "string",
                        "example": "COD",
                        "enum": [
                            "COD",
                            "MIDTRANS"
                        ]
                    }
                },
                "type": "object"
            },
            "AbsensiRequest": {
                "required": [
                    "koordinat_absen"
                ],
                "properties": {
                    "koordinat_absen": {
                        "description": "Format: latitude,longitude",
                        "type": "string",
                        "example": "-6.200000,106.816666"
                    }
                },
                "type": "object"
            },
            "UpdateOrderStatusRequest": {
                "required": [
                    "status"
                ],
