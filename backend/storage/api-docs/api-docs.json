                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/admin/riwayat-pembelian": {
            "get": {
                "tags": [
                    "Admin",
                    "Orders"
                ],
                "summary": "Admin: list all orders",
                "operationId": "adminOrdersIndex",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "mart_id",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "date_from",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "date_to",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Admin orders"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/admin/riwayat-pembelian/{id}/status": {
            "put": {
                "tags": [
                    "Admin",
                    "Orders"
                ],
                "summary": "Admin: update order status",
                "operationId": "adminOrdersUpdateStatus",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateOrderStatusRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Status updated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/admin/galon": {
            "get": {
                "tags": [
                    "Admin",
                    "Galon"
                ],
                "summary": "Admin: list galon orders",
                "operationId": "adminGalonIndex",
                "responses": {
                    "200": {
                        "description": "Admin galon list"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/admin/galon/{id}/status": {
            "put": {
                "tags": [
                    "Admin",
                    "Galon"
                ],
                "summary": "Admin: update galon status",
                "operationId": "adminGalonUpdateStatus",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
