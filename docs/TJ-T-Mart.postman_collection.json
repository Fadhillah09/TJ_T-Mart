{
  "info": {
    "_postman_id": "tj-t-mart-api-v2",
    "name": "TJ-T-Mart API",
    "description": "REST API collection for TJ-T-Mart dormitory mini-mart.\n\nImport environment: docs/TJ-T-Mart.postman_environment.json\nRun Auth > Login first to auto-save {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"newuser@tjmart.com\",\n  \"password\": \"Password1a\",\n  \"password_confirmation\": \"Password1a\",\n  \"phone\": \"081234567890\",\n  \"nomor_kamar\": \"A-101\",\n  \"penghuni_asrama\": true\n}"
            },
            "url": "{{base_url}}/auth/register"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": { \"user\": { \"id\": 1, \"name\": \"Test User\", \"email\": \"newuser@tjmart.com\" } },\n  \"message\": \"Registrasi berhasil. Silakan verifikasi email Anda.\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (json.data && json.data.access_token) {",
                "  pm.collectionVariables.set('token', json.data.access_token);",
                "  pm.environment.set('token', json.data.access_token);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@tjmart.com\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"access_token\": \"1|abc123token\",\n    \"token_type\": \"Bearer\",\n    \"user\": { \"id\": 4, \"name\": \"Customer\", \"email\": \"customer@tjmart.com\" }\n  },\n  \"message\": \"Login berhasil\"\n}"
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/auth/me"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/auth/logout"
          },
          "response": []
        },
        {
          "name": "Logout All",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/auth/logout-all"
          },
          "response": []
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/auth/email/resend"
          },
          "response": []
        }
      ]
    },
    {
