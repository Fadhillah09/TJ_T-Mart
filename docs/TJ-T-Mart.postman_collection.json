    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (json.data && json.data.access_token) {",
                "  pm.collectionVariables.set('token', json.data.access_token);",
                "  pm.environment.set('token', json.data.access_token);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@tjmart.com\",\n  \"password\": \"password\"\n}" },
            "url": "{{base_url}}/auth/login"
          },
          "response": []
        },
        {
          "name": "List All Products",
          "request": {
            "method": "GET",
            "header": [
